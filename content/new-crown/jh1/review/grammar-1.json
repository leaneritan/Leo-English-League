      { "rule": "4. Period at the end", "example": "I am a student.", "jp": "文の終わりにピリオド" },
      { "rule": "5. Question mark", "example": "Do you like music?", "jp": "疑問文の終わりは？" },
      { "rule": "6. Comma after Yes / No", "example": "Yes, I do. / No, I don't.", "jp": "Yes・Noの後にカンマ" },
